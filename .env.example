# Generate once and keep this value in your deployment secret manager:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# The resulting base64url value must decode to exactly 32 bytes.
UPLINK_SESSION_ENCRYPTION_KEY=

# Optional. This path is relative to the application directory.
# UPLINK_SESSION_STORE_PATH=.data/uplink-sessions.enc.json
