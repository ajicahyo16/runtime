{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lacify.dev/schemas/actor.schema.json",
  "title": "Lacify Runtime Actor",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "partitionBy", "storage", "commands"],
  "properties": {
    "version": { "const": "lacify.dev/actor/v1" },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,62}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "partitionBy": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,62}$"
    },
    "storage": { "const": "sqlite" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]{0,62}$"
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\./operations/[a-z0-9][a-z0-9-]{0,62}\\.operation\\.yaml$"
      }
    },
    "stateMachines": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/stateMachine" }
    },
    "summaries": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/summary" }
    },
    "secretRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,62}$"
      }
    }
  },
  "$defs": {
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "initial", "states", "transitions"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,62}$" },
        "initial": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,62}$" },
        "states": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,62}$" }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "from", "to"],
            "properties": {
              "command": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,62}$" },
              "from": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,62}$" },
              "to": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,62}$" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "period", "sourceTable"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "period": { "enum": ["daily", "monthly", "yearly"] },
        "sourceTable": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
      }
    }
  }
}
