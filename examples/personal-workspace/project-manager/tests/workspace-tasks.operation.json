{
  "name": "workspace tasks module",
  "actor": "Workspace",
  "partition": "module-workspace",
  "steps": [
    {
      "operation": "CreateTask",
      "idempotencyKey": "module-task-1",
      "input": {
        "taskId": "module-task",
        "title": "Reusable task"
      },
      "expectData": {
        "id": "module-task",
