        "completed": 0
      }
    },
    {
      "operation": "CompleteTask",
      "idempotencyKey": "module-task-2",
      "input": {
        "taskId": "module-task"
      },
      "expectData": {
        "id": "module-task",
        "title": "Reusable task",
        "completed": 1
      }
    }
  ]
}
