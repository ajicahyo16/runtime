{
  "name": "lacify-runtime-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "lacify": "./bin/lacify.mjs",
    "lacify-mcp": "./bin/lacify-mcp.mjs"
  },
  "scripts": {
    "dev": "vite",
    "control:dev": "wrangler dev --config wrangler.control-plane.toml --local --port 8787 --var ALLOWED_ORIGIN:http://127.0.0.1:5176",
    "test:control": "node --experimental-strip-types --test control-plane/test/*.test.mjs hosting/*.test.mjs",
    "test:phase10": "node --test runtime-spec/test/*.test.mjs",
    "test": "npm run test:control && npm run test:phase10",
    "security:check": "npm audit --audit-level=high && node scripts/security-check.mjs",
    "build": "tsc -b && vite build",
    "ui:deploy": "npm run build && wrangler deploy --config wrangler.ui.toml",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^5.2.1",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
